APP_NAME="AR Finance Tools"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=absensi_dmx
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# Mail (for reminders)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@dmx.co.id
MAIL_FROM_NAME="AR Finance Tools"

# WhatsApp API (optional)
WA_API_URL=https://api.whatsapp.com/send
WA_API_TOKEN=

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000

# Accurate Import
ACCURATE_API_URL=
ACCURATE_API_KEY=
